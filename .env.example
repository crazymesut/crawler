# RabbitMQ bağlantı bilgileri
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_QUEUE=crawler_queue

# HTTP sağlık kontrolü (health check) portu
PORT=3000

# Sayfa render zaman aşımı (ms)
RENDER_TIMEOUT_MS=60000

# Aynı anda işlenecek mesaj sayısı (RabbitMQ prefetch)
PREFETCH_COUNT=10

# Bağlantı koptuğunda yeniden deneme aralığı (ms)
RECONNECT_DELAY_MS=5000
