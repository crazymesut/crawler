# RabbitMQ bağlantı bilgileri
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=crawler
RABBITMQ_QUEUE=crawler_queue
RABBITMQ_RESULTS_QUEUE=crawler_results
RABBITMQ_DEAD_QUEUE=crawler_dead
# Boş bırakılırsa hostname:pid kullanılır; makineler arasında benzersiz olmalı.
WORKER_ID=

# HTTP sağlık kontrolü (health check) portu
PORT=3000

# Sayfa render zaman aşımı (ms)
RENDER_TIMEOUT_MS=60000

# Aynı anda işlenecek mesaj sayısı (RabbitMQ prefetch)
PREFETCH_COUNT=1

# Bağlantı koptuğunda yeniden deneme aralığı (ms)
RECONNECT_DELAY_MS=5000
PUBLISH_TIMEOUT_MS=10000
MAX_ATTEMPTS=3
RETRY_DELAYS_MS=30000,120000
MAX_HTML_BYTES=4194304
